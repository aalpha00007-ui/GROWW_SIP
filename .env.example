# Copy to .env (or .env.local) and fill in. Both are gitignored; never commit a real value.
# If a key is in both, .env.local wins.
# Neon Postgres connection string (neon.tech > your project > Connection string).
DATABASE_URL=
# Mistral API key (console.mistral.ai > API keys). Used on the server only.
MISTRAL_API_KEY=
# The free Mistral plan allows 0 requests a minute on mistral-small and mistral-medium; ministral-8b works (188 a minute).
MISTRAL_MODEL=ministral-8b-latest
# Groq reads the reason (call 1), with Mistral as its backup (architecture decision D4). Free, no card: console.groq.com > API Keys.
# Leave empty to let Mistral read too.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PROMPT_VERSION=v6
# The eval gate (PRD §7). Golden-set theme agreement floor (0-1): catches a broken prompt or model; never lower it to get a green build.
# The floor comes from six measured runs (65-80% on identical runs); EVAL_THEME_TARGET is what we aim for and is reported, not gating.
EVAL_THEME_THRESHOLD=0.65
EVAL_THEME_TARGET=0.75
